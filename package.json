{
  "name": "first-millennium-tactics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "FMT — a 1v1 hex tactics game about first-millennium warfare (working title).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
